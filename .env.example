# ── GCP billing (consumed by /api/billing) ──────────────────────────────────
# Set these in the Vercel dashboard (Project → Settings → Environment Variables).
# For local testing with `vercel dev`, copy this file to `.env` (git-ignored).

# Project that hosts the BigQuery billing-export dataset.
GCP_PROJECT_ID=synaptech-billing

# Service-account credentials. The account needs, on the billing project:
#   • roles/bigquery.dataViewer  (read the export table)
#   • roles/bigquery.jobUser     (run the query)
GCP_CLIENT_EMAIL=billing-reader@synaptech-billing.iam.gserviceaccount.com

# Paste the full private key on one line, keeping the literal "\n" sequences
# (do NOT expand them). Wrap the whole value in double quotes.
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Cloud Billing export table(s). Find them under BigQuery once the export is on.
# Con UNA cuenta de facturación basta una tabla:
#   GCP_BILLING_TABLE=billing.gcp_billing_export_v1_01335B_EEAF2A_5F253C
#
# Con VARIAS cuentas de facturación (tu caso) tienes dos opciones:
#   a) Si exportaste ambas al MISMO dataset, usa un wildcard que las une:
#        GCP_BILLING_TABLE=billing.gcp_billing_export_v1_*
#   b) Si están en datasets distintos, sepáralas por coma:
#        GCP_BILLING_TABLE=billing.gcp_billing_export_v1_01335B,billing2.gcp_billing_export_v1_0146C3
GCP_BILLING_TABLE=billing.gcp_billing_export_v1_*

# ── Web Push (consumido por /api/push/* y los crons) ─────────────────────────
# Genera el par de claves VAPID una vez:  npx web-push generate-vapid-keys
# La pública va también con prefijo VITE_ para que el cliente pueda suscribirse.
VAPID_PUBLIC_KEY=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_VAPID_PUBLIC_KEY=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
VAPID_SUBJECT=mailto:ignaciiio.mate@gmail.com

# Almacén de suscripciones (Upstash Redis vía Vercel Marketplace).
# La integración de Vercel suele inyectar estas dos automáticamente
# (también acepta los nombres KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Umbral para la alerta de gasto GCP (en la moneda del billing). Vacío = desactivada.
BILLING_ALERT_THRESHOLD=50

# Salto día-a-día (en la moneda del billing) que dispara la "alerta de pico". Default: 5.
BILLING_SPIKE_THRESHOLD=5

# Protege los endpoints de cron. Vercel lo envía solo en sus llamadas de cron.
CRON_SECRET=pon-aqui-un-string-aleatorio-largo

# ── Persistencia del portafolio en el servidor (/api/portfolio) ──────────────
# Token que habilita guardar cambios en la nube. Sin esto, las escrituras se
# rechazan (la app sigue funcionando en modo local). Inventa un string largo.
PORTFOLIO_EDIT_TOKEN=pon-aqui-otro-string-aleatorio-largo
